        "androidx.lifecycle:lifecycle-runtime-compose:2.8.7",
        "androidx.savedstate:savedstate:1.3.2",
        "androidx.savedstate:savedstate-ktx:1.3.2",
        # ADDITIONS OVER BOM
        "androidx.activity:activity-compose:1.9.0",
        "androidx.navigation:navigation-compose:2.7.7",
        "androidx.media3:media3-exoplayer:1.5.1",
        "androidx.media3:media3-common:1.5.1",
        "androidx.media3:media3-datasource:1.5.1",
        "androidx.media3:media3-session:1.5.1",
        "androidx.media3:media3-extractor:1.5.1",
        "com.google.guava:guava:33.0.0-android",
        "androidx.core:core-ktx:1.13.1",
        "androidx.lifecycle:lifecycle-livedata-ktx:2.9.2",
        # TEST
        "junit:junit:4.13.2",
        "org.robolectric:robolectric:4.14.1",
        "org.robolectric:shadows-framework:4.14.1",
        "androidx.test:runner:1.6.2",
        "androidx.test:rules:1.6.1",
        "androidx.test:core:1.6.1",
        "androidx.test:monitor:1.7.2",
        "androidx.test.ext:junit:1.2.1",
        # THIRD-PARTY
        "com.indidevs.android:shellom:0.2.0-beta-1",
        "com.indidevs.android:adbeesh:0.1.0-beta-2",
        "dev.rikka.shizuku:api:13.1.5",
        "dev.rikka.shizuku:provider:13.1.5",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.10.2",
        "io.mockk:mockk-jvm:1.14.12",
        "com.github.alorma.compose-settings:ui-tiles-android:3.1.0",
    ],
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://repo1.maven.org/maven2",
        "https://repo.maven.apache.org/maven2",
        "https://maven.google.com",
        "https://androidx.dev",
        "https://jitpack.io",
    ],
    fail_on_missing_checksum = False,
    version_conflict_policy = "pinned",
    lock_file = "//:android_install.json",
    fail_if_repin_required = True,
    repin_instructions = "!!! Run 'REPIN=1 bazel run @unpinned_android//:pin' to update the lockfile !!!",
)

