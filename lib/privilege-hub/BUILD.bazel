load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_android//rules:rules.bzl", "android_library")
load("//tools/bazel:android_test.bzl", "android_test_suite")

exports_files(["src/main/AndroidManifest.xml"])

kt_android_library(
    name = "privilege-hub",
    srcs = glob([
        "src/main/kotlin/**/*.kt",
    ]),
    deps = [
        "@android//:androidx_core_core_ktx",
        "@android//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
        "@android//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
        "@android//:com_indidevs_android_adbeesh",
        "@android//:com_indidevs_android_shellom",
        "@android//:dev_rikka_shizuku_api",
        "@android//:dev_rikka_shizuku_provider",
    ],
    exports = [
        "@android//:com_indidevs_android_adbeesh",
        "@android//:com_indidevs_android_shellom",
        "@android//:dev_rikka_shizuku_api",
        "@android//:dev_rikka_shizuku_provider",
    ],
    custom_package = "com.indidevs.android.privilegehub",
    visibility = ["//visibility:public"],
)

android_test_suite(
    name = "privilege_hub_tests",
    srcs = glob(["src/test/kotlin/**/*Test.kt"]),
    custom_package = "com.indidevs.android.privilegehub.test",
    manifest = "src/test/AndroidManifest.xml",
    associates = [":privilege-hub"],
    tags = ["unit", "robolectric"],
    visibility = ["//visibility:public"],
    deps = [
        "@android//:junit_junit",
        "@android//:org_robolectric_robolectric",
        "@android//:androidx_test_core",
        "@android//:androidx_test_runner",
        "@android//:androidx_test_ext_junit",
        "@android//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
        "@android//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
        "@android//:org_jetbrains_kotlinx_kotlinx_coroutines_test",
        "@android//:io_mockk_mockk_jvm",
    ],
)
