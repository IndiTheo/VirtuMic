      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>inditheo</id>
      <name>IndiTheo</name>
    </developer>
    <developer>
      <id>indidevs</id>
      <name>IndiDevs</name>
      <email>contact-project+indidevs-virtumic-development@incoming.gitlab.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:gitlab.com/IndiDevs/VirtuMic.git</connection>
    <developerConnection>scm:git:ssh://gitlab.com/IndiDevs/VirtuMic.git</developerConnection>
    <url>https://gitlab.com/IndiDevs/VirtuMic/-/tree/main</url>
  </scm>

  <properties>
    <!-- Android -->
    <android.compileSdkVersion>37</android.compileSdkVersion>
    <android.minSdkVersion>31</android.minSdkVersion>
  </properties>

  <dependencies>
    {dependencies}
  </dependencies>
</project>
